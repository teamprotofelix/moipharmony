    {
      "id": "h05.kr.dossier.legal",
      "documentId": "h05.kr.dossier",
      "office": "KR",
      "originalLanguage": "ko",
      "originalText": "KR 적용 기준(합성): D1과의 구성 대비에서, 주지관용기술이 아닌 D1의 프로파일 기반 조정을 E3에 대응하여 진보성 부정의 근거로 사용. (합성 기록)",
      "gloss": { "ko": "KR 법역 기준(합성): D1의 프로파일 기반 조정을 E3 대응으로 사용", "en": "KR legal standard (synthetic): D1's profile-based adjustment used against E3", "ja": "KR法域基準（合成）: D1のプロファイルベース調整をE3対応として使用" },
